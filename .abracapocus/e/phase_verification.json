{
  "verification": {
    "checks": [
      {
        "name": "configure",
        "command": [
          "cmake",
          "-B",
          "build",
          "-DCMAKE_BUILD_TYPE=Release"
        ]
      },
      {
        "name": "build-tests",
        "command": [
          "cmake",
          "--build",
          "build",
          "--target",
          "ShredBoostTests"
        ]
      },
      {
        "name": "ctest",
        "command": [
          "ctest",
          "--test-dir",
          "build",
          "--output-on-failure"
        ]
      }
    ]
  }
}
